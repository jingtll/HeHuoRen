{
  "rootDir": "..",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true }]
  },
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "clearMocks": true
}
